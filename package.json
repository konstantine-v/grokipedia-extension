{
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "esbuild src/service-worker.ts src/popup.ts src/content.ts src/content.css --outdir=. --bundle --format=iife",
    "dev": "esbuild src/service-worker.ts src/popup.ts src/content.ts src/content.css --outdir=. --bundle --format=iife --watch",
